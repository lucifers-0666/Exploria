<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Tours_Travels.Site1" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Exploria - Tours & Travels</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>">
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>">

    <!-- CDNs and Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <!-- Custom Styles -->
    <style>
        :root {
            --midnight-green: #073b3a;
            --dartmouth-green: #0b6e4f;
            --pigment-green: #08a045;
            --mantis: #6bbf59;
            --ecru: #ddb771;
            --ivory-bg: #fcf8f3;
            --text-dark: #1f2937;
            --text-light: #4b5563;
            /* Enhanced Color Palette */
            --primary-emerald: #1d5e33;
            --emerald: #1d5e33;
            --emerald-dark: #164426;
            --emerald-light: #2a7d4a;
            --emerald-pale: #e8f4ed;
            --champagne-gold: #E5CBAF;
            --gold-rich: #c9a877;
            --gold-shimmer: #f5e8d8;
            --gold-light: #d4b896;
        }

        body {
            font-family: "Poppins", sans-serif;
            background-color: var(--ivory-bg);
            padding-top: 0; /* NO padding - hero section starts at top */
            margin: 0;
        }

        body.scrolled {
            padding-top: 0; /* Keep zero padding */
        }

        .heading-font {
            font-family: "Playfair Display", serif;
        }

        .container {
            max-width: 90%;
            margin: 0 auto;
        }

        @media (max-width: 768px) {
            .container {
                max-width: 95%;
            }
            body {
                padding-top: 80px;
            }
        }

        /* ============================================
           ENHANCED HEADER - COMPLETE DESIGN
           ============================================ */
        
        /* Page Load Progress Bar */
        .page-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, #1d5e33, #E5CBAF, #c9a877);
            z-index: 1002;
            animation: progressBar 1.5s ease-out forwards;
            transform-origin: left;
        }

        @keyframes progressBar {
            0% {
                width: 0;
            }
            50% {
                width: 70%;
            }
            100% {
                width: 100%;
                opacity: 0;
            }
        }

        /* Top Utility Bar - Enhanced Modern Design */
        .utility-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
            height: 40px;
            background: var(--emerald-dark); /* Solid color for better contrast */
            font-size: 13px;
            transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);
            border-bottom: 1px solid rgba(42, 125, 74, 0.3);
            animation: fadeInDown 600ms ease-out;
        }

        .utility-bar.hide-on-scroll {
            transform: translateY(-100%);
            opacity: 0;
            pointer-events: none;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .utility-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 24px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .utility-left,
        .utility-right {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .utility-item {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--emerald-pale);
            text-decoration: none;
            font-size: 13px;
            transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .utility-item:hover {
            color: var(--gold-shimmer);
            transform: translateY(-1px);
        }

        .utility-item i {
            font-size: 12px;
            color: var(--champagne-gold);
            transition: all 300ms ease;
        }

        .utility-item:hover i {
            transform: scale(1.1);
            color: var(--gold-shimmer);
        }

        .utility-separator {
            width: 1px;
            height: 16px;
            background: var(--emerald-light);
            margin: 0 12px;
        }

        .utility-social {
            display: flex;
            gap: 12px;
        }

        .social-link {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--emerald-pale);
            transition: all 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
            border-radius: 50%;
            position: relative;
            text-decoration: none;
        }

        .social-link i {
            font-size: 14px;
            transition: all 300ms ease;
        }

        .social-link:hover {
            color: var(--champagne-gold);
            transform: translateY(-2px) scale(1.15) rotate(5deg);
        }

        .social-link:hover i {
            transform: scale(1.1);
        }

        .utility-dropdown {
            position: relative;
            cursor: pointer;
            padding: 4px 10px;
            border-radius: 4px;
            color: var(--emerald-pale);
            transition: all 250ms ease;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .utility-dropdown:hover {
            background: rgba(42, 125, 74, 0.2);
            color: var(--champagne-gold);
        }

        .utility-dropdown i {
            font-size: 10px;
            transition: transform 300ms ease;
        }

        .utility-dropdown:hover i {
            transform: rotate(180deg);
        }

        .utility-dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 120px;
            background: white;
            border-radius: 6px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            padding: 8px 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 200ms ease;
            z-index: 1000;
        }

        .utility-dropdown:hover .utility-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .utility-dropdown-menu a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 16px;
            color: var(--emerald-dark);
            text-decoration: none;
            font-size: 13px;
            transition: all 150ms ease;
        }

        .utility-dropdown-menu a:hover {
            background: var(--emerald-pale);
            color: var(--primary-emerald);
        }

        .utility-dropdown-menu a.active {
            color: var(--champagne-gold);
            font-weight: 600;
        }

        .utility-dropdown-menu a.active i {
            display: block;
            color: var(--champagne-gold);
        }

        .utility-dropdown-menu a i {
            display: none;
            font-size: 12px;
        }

        /* Main Navigation Header - FIXED: Transparent to Solid White */
        .modern-header {
            position: fixed;
            top: 40px;
            left: 0;
            right: 0;
            z-index: 999;
            height: 90px;
            background: transparent; /* TRULY TRANSPARENT - No color at all */
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            box-shadow: none;
            border-bottom: none;
            transition: all 500ms cubic-bezier(0.4, 0, 0.2, 1);
            animation: slideInFromTop 800ms cubic-bezier(0.4, 0, 0.2, 1);
            will-change: background-color, box-shadow, height, top;
        }

        .modern-header.scrolled {
            top: 0;
            height: 72px;
            background: rgba(255, 255, 255, 0.97); /* WHITE background when scrolled */
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 4px 24px rgba(29, 94, 51, 0.12);
            border-bottom: 1px solid rgba(201, 168, 119, 0.25);
        }

        @keyframes slideInFromTop {
            from {
                opacity: 0;
                transform: translateY(-40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 40px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Logo Styles - Minimalist Text Only */
        .logo-container {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            transition: all 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
            text-decoration: none;
        }

        .logo-container:hover {
            transform: scale(1.02);
        }

        .logo-container:hover .logo-text {
            text-shadow: 0 0 20px rgba(229, 203, 175, 0.6);
            letter-spacing: 0.5px;
        }

        .logo-icon {
            width: 30px;
            height: 30px;
            font-size: 30px;
            color: var(--champagne-gold);
            filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4)); /* Shadow for visibility */
            transition: all 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .logo-container:hover .logo-icon {
            transform: translateX(8px) translateY(-8px) rotate(-15deg);
        }
        
        .logo-container:hover .logo-text {
            text-shadow: 0 0 20px rgba(229, 203, 175, 0.6);
            letter-spacing: 0.5px;
        }

        .logo-text {
            font-family: "Playfair Display", serif;
            font-size: 28px;
            font-weight: 600;
            letter-spacing: 0px;
            color: #FFFFFF;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6); /* Strong shadow for visibility */
            transition: all 500ms ease;
        }

        /* Scrolled state - logo changes to DARK emerald */
        .modern-header.scrolled .logo-text {
            font-size: 26px;
            color: #164426; /* Emerald-dark */
            text-shadow: none;
        }

        .modern-header.scrolled .logo-icon {
            font-size: 26px;
            width: 26px;
            height: 26px;
            color: #c9a877; /* Gold-rich */
            filter: none;
        }

        @media (max-width: 768px) {
            .logo-text {
                font-size: 24px;
            }
            .logo-icon {
                font-size: 24px;
                width: 24px;
                height: 24px;
            }
            .modern-header.scrolled .logo-text {
                font-size: 22px;
            }
        }

        /* Navigation Menu - Enhanced with Visibility */
        .nav-menu {
            display: flex;
            align-items: center;
            gap: 8px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nav-item {
            position: relative;
            animation: fadeInUp 600ms ease-out backwards;
        }

        /* Staggered animation for nav items */
        .nav-item:nth-child(1) { animation-delay: 100ms; }
        .nav-item:nth-child(2) { animation-delay: 200ms; }
        .nav-item:nth-child(3) { animation-delay: 300ms; }
        .nav-item:nth-child(4) { animation-delay: 400ms; }
        .nav-item:nth-child(5) { animation-delay: 500ms; }
        .nav-item:nth-child(6) { animation-delay: 600ms; }
        .nav-item:nth-child(7) { animation-delay: 700ms; }
        .nav-item:nth-child(8) { animation-delay: 800ms; }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .nav-link {
            position: relative;
            padding: 12px 16px;
            font-size: 15px;
            font-weight: 500;
            color: #FFFFFF;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6); /* Strong shadow for visibility */
            letter-spacing: 0.3px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            cursor: pointer;
        }

        .nav-link > i:first-child {
            font-size: 18px;
            color: var(--champagne-gold);
            filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4)); /* Shadow for icons */
            transition: all 300ms ease;
        }

        .nav-link:hover > i:first-child {
            transform: scale(1.05);
            color: var(--gold-shimmer);
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
        }

        .nav-link:hover {
            color: var(--champagne-gold);
            transform: translateY(-1px);
        }

        /* Underline animation */
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 6px;
            left: 16px;
            width: 0;
            height: 2px;
            background: var(--champagne-gold);
            transition: width 300ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-link:hover::after {
            width: calc(100% - 32px);
        }

        /* Active page */
        .nav-link.active {
            color: var(--champagne-gold);
            font-weight: 600;
        }

        .nav-link.active::after {
            width: calc(100% - 32px);
        }

        /* Chevron icon for dropdowns */
        .chevron-icon {
            font-size: 10px;
            margin-left: 2px;
            color: rgba(255, 255, 255, 0.6) !important;
            transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .nav-item:hover .chevron-icon {
            transform: rotate(180deg);
        }

        /* Scrolled state - Change to DARK emerald text on white background */
        .modern-header.scrolled .nav-link {
            color: #164426; /* Emerald-dark */
            font-size: 15px;
            text-shadow: none; /* Remove shadow on white background */
        }

        .modern-header.scrolled .nav-link > i:first-child {
            color: #164426; /* Emerald-dark icons */
            filter: none;
        }

        .modern-header.scrolled .nav-link:hover {
            color: #c9a877; /* Gold-rich on hover */
        }

        .modern-header.scrolled .nav-link:hover > i:first-child {
            color: #c9a877; /* Gold-rich icons on hover */
        }

        .modern-header.scrolled .nav-link.active {
            color: #c9a877; /* Gold-rich for active */
        }

        .modern-header.scrolled .nav-link.active > i:first-child {
            color: #c9a877;
        }
        
        /* Underline changes to gold-rich when scrolled */
        .modern-header.scrolled .nav-link::after {
            background: #c9a877;
        }

        /* Dropdown Menus - Enhanced Modern Design */
        .dropdown-menu {
            position: absolute;
            top: calc(100% + 12px);
            left: 0;
            min-width: 280px;
            background: white;
            border-radius: 12px;
            padding: 16px 0;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            border: 1px solid var(--emerald-pale);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

        .nav-item:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            animation-delay: 150ms;
        }

        .dropdown-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: var(--emerald-dark);
            font-size: 14px;
            text-decoration: none;
            transition: all 200ms ease;
            position: relative;
        }

        .dropdown-menu a i {
            font-size: 16px;
            color: var(--champagne-gold);
            transition: all 200ms ease;
        }

        .dropdown-menu a:hover {
            background: var(--emerald-pale);
            color: var(--primary-emerald);
            padding-left: 24px;
        }

        .dropdown-menu a:hover i {
            transform: translateX(4px);
        }

        /* Trending badge */
        .trending-badge {
            background: var(--champagne-gold);
            color: var(--primary-emerald);
            font-size: 10px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 12px;
            margin-left: auto;
            animation: pulse-badge 2s ease-in-out infinite;
        }

        @keyframes pulse-badge {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Fire icon animation for trending */
        .fire-icon {
            animation: flicker 1.5s ease-in-out infinite;
        }

        @keyframes flicker {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        /* Multi-column dropdown for destinations */
        .dropdown-wide {
            min-width: 600px;
            padding: 20px;
        }

        .dropdown-columns {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .dropdown-column h4 {
            padding: 8px 20px;
            color: #1d5e33;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            border-bottom: 2px solid #e8f4ed;
        }

        .dropdown-column a {
            padding: 8px 20px;
        }

        /* Featured items in dropdown */
        .featured-item {
            display: flex;
            flex-direction: column;
            padding: 12px;
            border-radius: 8px;
            transition: transform 200ms ease;
            margin: 8px;
        }

        .featured-item:hover {
            transform: scale(1.03);
            background: #e8f4ed;
        }

        .featured-item img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 6px;
            margin-bottom: 8px;
        }

        .featured-item .price {
            color: #c9a877;
            font-weight: 600;
            font-size: 14px;
            margin-top: 4px;
        }

        /* Search Bar - Premium Design with Frosted Glass Effect */
        .search-bar {
            position: relative;
            width: 260px;
            transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        .search-input {
            width: 100%;
            height: 44px;
            padding: 0 18px 0 44px;
            border-radius: 24px;
            font-size: 14px;
            border: 2px solid rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.20); /* Frosted glass effect */
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: #FFFFFF;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
            transition: all 300ms ease;
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.75);
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        }

        .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 20px;
            color: rgba(255, 255, 255, 0.8);
            filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
            pointer-events: none;
            transition: all 300ms ease;
        }

        .search-input:focus {
            border-color: var(--champagne-gold);
            background: rgba(255, 255, 255, 0.95);
            color: var(--emerald-dark);
            text-shadow: none;
            outline: none;
            box-shadow: 0 4px 16px rgba(229, 203, 175, 0.3);
            width: 300px;
        }

        .search-input:focus::placeholder {
            color: rgba(22, 68, 38, 0.5);
            text-shadow: none;
        }

        .search-input:focus ~ .search-icon {
            color: var(--champagne-gold);
            filter: none;
            transform: translateY(-50%) scale(1.15) rotate(90deg);
        }

        /* Scrolled state - Emerald pale background */
        .modern-header.scrolled .search-input {
            background: rgba(232, 244, 237, 0.6); /* Emerald-pale */
            border-color: rgba(201, 168, 119, 0.5); /* Gold-rich */
            color: #164426; /* Emerald-dark */
            text-shadow: none;
            backdrop-filter: none;
        }

        .modern-header.scrolled .search-input::placeholder {
            color: rgba(22, 68, 38, 0.6);
            text-shadow: none;
        }

        .modern-header.scrolled .search-icon {
            color: #164426; /* Emerald-dark */
            filter: none;
        }

        .modern-header.scrolled .search-input:focus {
            background: rgba(232, 244, 237, 0.9);
            color: #164426;
            border-color: #c9a877; /* Gold-rich */
            box-shadow: 0 4px 16px rgba(201, 168, 119, 0.3);
        }

        .modern-header.scrolled .search-input:focus::placeholder {
            color: rgba(22, 68, 38, 0.5);
        }

        .modern-header.scrolled .search-input:focus ~ .search-icon {
            color: #c9a877; /* Gold-rich */
        }

        /* User Account - Premium Interactive */
        .user-account {
            position: relative;
        }

        .user-account-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.20); /* Frosted glass */
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.4);
            cursor: pointer;
            transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }

        .user-icon {
            font-size: 24px;
            color: #FFFFFF;
            filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
            transition: all 300ms ease;
        }

        .user-account-btn:hover {
            background: rgba(232, 244, 237, 0.4);
            border-color: var(--champagne-gold);
            transform: scale(1.08);
        }

        .user-account-btn:hover .user-icon {
            color: var(--champagne-gold);
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
        }

        /* Scrolled state - Emerald pale background */
        .modern-header.scrolled .user-account-btn {
            background: rgba(232, 244, 237, 0.7);
            border-color: rgba(201, 168, 119, 0.5);
            backdrop-filter: none;
        }

        .modern-header.scrolled .user-icon {
            color: #164426; /* Emerald-dark */
            filter: none;
        }

        .modern-header.scrolled .user-account-btn:hover {
            background: rgba(232, 244, 237, 1);
            border-color: #c9a877; /* Gold-rich */
            transform: scale(1.08);
        }

        .modern-header.scrolled .user-account-btn:hover .user-icon {
            color: #c9a877; /* Gold-rich */
        }

        /* User dropdown */
        .user-dropdown {
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            min-width: 200px;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            border-radius: 12px;
            padding: 8px 0;
            box-shadow: 0 12px 48px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(229, 203, 175, 0.3);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

        .user-account:hover .user-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-header {
            padding: 12px 20px;
            border-bottom: 1px solid #e8f4ed;
            margin-bottom: 8px;
        }

        .dropdown-header span {
            color: #1d5e33;
            font-weight: 600;
            font-size: 14px;
        }

        .user-dropdown a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: #164426;
            font-size: 14px;
            text-decoration: none;
            transition: all 200ms ease;
        }

        .user-dropdown a:hover {
            background: #e8f4ed;
            color: #1d5e33;
            padding-left: 24px;
        }

        .user-dropdown a i {
            font-size: 16px;
            color: #c9a877;
        }

        .dropdown-divider {
            height: 1px;
            background: #e8f4ed;
            margin: 8px 0;
        }

        /* CTA Button - Premium Design (Consistent in Both States) */
        .cta-book-now {
            padding: 13px 32px;
            font-size: 15px;
            font-weight: 600;
            border-radius: 28px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #1d5e33; /* Solid emerald - never transparent */
            color: #FFFFFF;
            border: 2px solid var(--champagne-gold);
            cursor: pointer;
            transition: all 320ms cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            white-space: nowrap;
            box-shadow: 0 4px 16px rgba(29, 94, 51, 0.3);
            position: relative;
        }

        .arrow-icon {
            font-size: 18px;
            color: var(--champagne-gold);
            transition: all 320ms ease;
        }

        .cta-book-now:hover {
            background: #2a7d4a; /* Emerald-light */
            border-color: #c9a877; /* Gold-rich */
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(42, 125, 74, 0.4);
        }

        .cta-book-now:hover .arrow-icon {
            transform: translateX(4px);
        }

        .cta-book-now:active {
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(29, 94, 51, 0.3);
        }

        /* Scrolled state - Button remains the same */
        .modern-header.scrolled .cta-book-now {
            /* No changes - stays consistent */
        }

        /* Right Section Container */
        .right-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .right-actions > * {
            animation: fadeInRight 600ms ease-out backwards;
        }

        .right-actions > :nth-child(1) { animation-delay: 900ms; }
        .right-actions > :nth-child(2) { animation-delay: 1000ms; }
        .right-actions > :nth-child(3) { animation-delay: 1100ms; }

        @keyframes fadeInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Mobile Hamburger Menu */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 0.5rem;
            z-index: 1001;
        }

        .hamburger span {
            width: 24px;
            height: 2px;
            background: white;
            border-radius: 2px;
            transition: all 300ms ease-in-out;
        }

        .modern-header.scrolled .hamburger span {
            background: white; /* Keep white on scrolled state */
        }

        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg) translateY(7px);
        }

        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg) translateY(-7px);
        }

        /* Mobile Menu Panel */
        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 100%;
            max-width: 280px;
            height: 100vh;
            background: var(--primary-emerald);
            transition: right 300ms ease-out;
            z-index: 999;
            padding: 5rem 0 2rem;
            overflow-y: auto;
            box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
        }

        .mobile-menu.active {
            right: 0;
        }

        .mobile-nav-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: white;
            text-decoration: none;
            transition: all 200ms ease;
            border-left: 3px solid transparent;
            opacity: 0;
            transform: translateX(20px);
        }

        .mobile-menu.active .mobile-nav-link {
            animation: slideIn 300ms ease-out forwards;
        }

        .mobile-nav-link:nth-child(1) { animation-delay: 50ms; }
        .mobile-nav-link:nth-child(2) { animation-delay: 100ms; }
        .mobile-nav-link:nth-child(3) { animation-delay: 150ms; }
        .mobile-nav-link:nth-child(4) { animation-delay: 200ms; }
        .mobile-nav-link:nth-child(5) { animation-delay: 250ms; }
        .mobile-nav-link:nth-child(6) { animation-delay: 300ms; }
        .mobile-nav-link:nth-child(7) { animation-delay: 350ms; }
        .mobile-nav-link:nth-child(8) { animation-delay: 400ms; }

        @keyframes slideIn {
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .mobile-nav-link:hover {
            background: var(--emerald-light);
            border-left-color: var(--champagne-gold);
        }

        .mobile-nav-link i {
            font-size: 1.25rem;
            color: var(--champagne-gold);
        }

        /* Mobile Overlay */
        .mobile-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            opacity: 0;
            visibility: hidden;
            transition: all 400ms ease-in-out;
            z-index: 998;
        }

        .mobile-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* Mobile Responsive Styles */
        @media (max-width: 1024px) {
            .utility-bar {
                display: none; /* Hide utility bar on tablet and mobile */
            }

            body {
                padding-top: 70px;
            }

            body.scrolled {
                padding-top: 65px;
            }

            .modern-header {
                top: 0;
                height: 65px;
            }

            .modern-header.scrolled {
                height: 60px;
            }

            .header-container {
                padding: 0 16px;
            }

            .nav-menu {
                display: none;
            }

            .hamburger {
                display: flex;
            }

            .search-bar {
                display: none;
            }

            .user-account-btn {
                width: 36px;
                height: 36px;
            }

            .user-icon {
                font-size: 14px;
            }

            .cta-book-now {
                padding: 10px 20px;
                font-size: 14px;
            }

            .mobile-menu {
                padding-top: 5rem;
            }
        }

        @media (max-width: 768px) {
            .modern-header {
                height: 64px; /* Smaller on mobile */
            }

            .modern-header.scrolled {
                height: 60px;
            }

            .logo-text {
                font-size: 24px;
            }

            .logo-icon {
                font-size: 24px;
                width: 24px;
                height: 24px;
            }

            .modern-header.scrolled .logo-text {
                font-size: 22px;
            }

            .cta-book-now span {
                display: none; /* Hide text on mobile */
            }

            .cta-book-now {
                padding: 10px;
                width: 44px;
                height: 44px;
                justify-content: center;
                border-radius: 50%;
            }

            .search-bar {
                display: none; /* Hide search on mobile */
            }

            .mobile-menu {
                max-width: 100%;
            }
        }

        @media (max-width: 480px) {
            .user-account {
                display: none;
            }

            .cta-book-now {
                width: 36px;
                height: 36px;
            }

            .arrow-icon {
                font-size: 16px;
            }
        }

        /* ============================================
           MODERN FOOTER
           ============================================ */
        .modern-footer {
          background: var(--emerald-dark);
          color: var(--emerald-pale);
          padding-top: 64px;
        }

        /* Main Footer Content */
        .footer-main-content {
          padding: 0 24px 48px;
          border-bottom: 1px solid rgba(42, 125, 74, 0.3);
        }

        .footer-container {
          max-width: 1400px;
          margin: 0 auto;
        }

        .footer-grid {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 48px;
        }

        /* Footer Column */
        .footer-column {
          display: flex;
          flex-direction: column;
        }

        /* Column 1: About - Logo */
        .footer-logo {
          display: flex;
          align-items: center;
          gap: 10px;
          margin-bottom: 20px;
        }

        .footer-logo-icon {
          font-size: 28px;
          color: var(--champagne-gold);
        }

        .footer-logo-text {
          font-family: "Playfair Display", serif;
          font-size: 26px;
          font-weight: 600;
          color: white;
        }

        /* Footer Description */
        .footer-description {
          font-size: 14px;
          color: var(--emerald-pale);
          line-height: 1.6;
          max-width: 280px;
          margin-bottom: 24px;
        }

        /* Social Icons */
        .footer-social-icons {
          display: flex;
          gap: 12px;
        }

        .footer-social-icon {
          width: 40px;
          height: 40px;
          border-radius: 50%;
          background: rgba(42, 125, 74, 0.2);
          display: flex;
          align-items: center;
          justify-content: center;
          color: var(--champagne-gold);
          text-decoration: none;
          transition: all 300ms ease;
        }

        .footer-social-icon i {
          font-size: 18px;
        }

        .footer-social-icon:hover {
          background: var(--champagne-gold);
          color: var(--primary-emerald);
          transform: translateY(-3px);
        }

        /* Column Titles - ENHANCED with decorative line */
        .footer-column-title {
          font-size: 18px;
          font-weight: 600;
          color: white;
          margin-bottom: 20px;
          position: relative;
          padding-top: 16px;
        }

        .footer-column-title::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          width: 40px;
          height: 2px;
          background: var(--champagne-gold);
          border-radius: 2px;
        }

        /* Footer Links - ENHANCED with underline animation */
        .footer-links {
          list-style: none;
          padding: 0;
          margin: 0;
        }

        .footer-links li {
          margin-bottom: 0;
        }

        .footer-link {
          display: inline-block;
          font-size: 14px;
          color: var(--emerald-pale);
          padding: 8px 0;
          text-decoration: none;
          transition: all 300ms ease;
          position: relative;
        }

        /* Underline animation on hover */
        .footer-link::after {
          content: '';
          position: absolute;
          bottom: 6px;
          left: 0;
          width: 0;
          height: 1px;
          background: var(--champagne-gold);
          transition: width 300ms ease;
        }

        .footer-link:hover {
          color: var(--champagne-gold);
        }

        .footer-link:hover::after {
          width: 100%;
        }

        /* Footer Newsletter - NEW */
        .footer-newsletter-text {
          font-size: 13px;
          color: var(--emerald-pale);
          opacity: 0.8;
          margin-bottom: 16px;
          line-height: 1.5;
        }

        .footer-newsletter-form {
          margin-bottom: 24px;
        }

        .footer-newsletter-input-group {
          display: flex;
          gap: 8px;
          margin-bottom: 8px;
        }

        .footer-newsletter-input {
          flex: 1;
          padding: 10px 14px;
          border: 1px solid rgba(42, 125, 74, 0.3);
          border-radius: 6px;
          background: rgba(42, 125, 74, 0.1);
          color: white;
          font-size: 13px;
          outline: none;
          transition: all 300ms ease;
        }

        .footer-newsletter-input::placeholder {
          color: rgba(232, 244, 237, 0.5);
        }

        .footer-newsletter-input:focus {
          border-color: var(--champagne-gold);
          background: rgba(42, 125, 74, 0.15);
          box-shadow: 0 0 0 3px rgba(229, 203, 175, 0.1);
        }

        .footer-newsletter-input:invalid:not(:placeholder-shown) {
          border-color: rgba(231, 76, 60, 0.5);
        }

        .footer-newsletter-input:valid:not(:placeholder-shown) {
          border-color: rgba(46, 204, 113, 0.5);
        }

        .footer-newsletter-btn {
          width: 40px;
          height: 40px;
          border: none;
          border-radius: 6px;
          background: var(--champagne-gold);
          color: var(--primary-emerald);
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: all 300ms ease;
        }

        .footer-newsletter-btn i {
          font-size: 18px;
        }

        .footer-newsletter-btn:hover:not(:disabled) {
          background: var(--gold-rich);
          transform: translateY(-2px);
          box-shadow: 0 4px 12px rgba(229, 203, 175, 0.3);
        }

        .footer-newsletter-btn:active:not(:disabled) {
          transform: translateY(0);
        }

        .footer-newsletter-btn:disabled {
          opacity: 0.6;
          cursor: not-allowed;
        }

        .footer-newsletter-btn .la-spin {
          animation: footerSpinner 1s linear infinite;
        }

        @keyframes footerSpinner {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }

        .footer-newsletter-btn:hover {
          background: var(--gold-rich);
          transform: translateY(-2px);
        }

        .footer-newsletter-privacy {
          display: flex;
          align-items: center;
          gap: 6px;
          font-size: 11px;
          color: var(--emerald-pale);
          opacity: 0.6;
          margin: 0;
        }

        .footer-newsletter-privacy i {
          font-size: 12px;
        }

        /* Contact Items */
        .footer-contact-items {
          display: flex;
          flex-direction: column;
          gap: 0;
        }

        .footer-contact-item {
          display: flex;
          align-items: flex-start;
          gap: 12px;
          margin-bottom: 16px;
          font-size: 14px;
          color: var(--emerald-pale);
          transition: color 300ms ease;
        }

        .footer-contact-item i {
          font-size: 16px;
          color: var(--champagne-gold);
          margin-top: 2px;
          flex-shrink: 0;
        }

        .footer-contact-link {
          text-decoration: none;
          cursor: pointer;
        }

        .footer-contact-link:hover {
          color: white;
        }

        /* Bottom Bar - ENHANCED */
        .footer-bottom-bar {
          background: var(--emerald-dark);
          padding: 24px;
          border-top: 1px solid rgba(42, 125, 74, 0.3);
        }

        .footer-bottom-content {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 24px;
          flex-wrap: wrap;
        }

        /* Bottom Left - Copyright & Links */
        .footer-bottom-left {
          display: flex;
          flex-direction: column;
          gap: 12px;
        }

        .footer-copyright {
          font-size: 14px;
          color: var(--emerald-pale);
          opacity: 0.7;
        }

        .footer-bottom-links {
          display: flex;
          align-items: center;
          gap: 12px;
          flex-wrap: wrap;
        }

        .footer-bottom-link {
          font-size: 13px;
          color: var(--emerald-pale);
          text-decoration: none;
          opacity: 0.7;
          transition: all 300ms ease;
          position: relative;
        }

        .footer-bottom-link::after {
          content: '';
          position: absolute;
          bottom: -2px;
          left: 0;
          width: 0;
          height: 1px;
          background: var(--champagne-gold);
          transition: width 300ms ease;
        }

        .footer-bottom-link:hover {
          color: var(--champagne-gold);
          opacity: 1;
        }

        .footer-bottom-link:hover::after {
          width: 100%;
        }

        .footer-link-separator {
          color: rgba(232, 244, 237, 0.3);
          font-size: 12px;
        }

        /* Language & Currency Switchers - NEW */
        .footer-switchers {
          display: flex;
          gap: 16px;
          align-items: center;
        }

        .footer-switcher {
          display: flex;
          align-items: center;
          gap: 8px;
        }

        .footer-switcher i {
          font-size: 16px;
          color: var(--champagne-gold);
        }

        .footer-select {
          background: rgba(42, 125, 74, 0.2);
          border: 1px solid rgba(42, 125, 74, 0.3);
          border-radius: 6px;
          padding: 6px 12px;
          color: var(--emerald-pale);
          font-size: 13px;
          cursor: pointer;
          outline: none;
          transition: all 300ms ease;
        }

        .footer-select:hover {
          border-color: var(--champagne-gold);
          background: rgba(42, 125, 74, 0.3);
        }

        .footer-select:focus {
          border-color: var(--champagne-gold);
        }

        .footer-select option {
          background: var(--emerald-dark);
          color: white;
        }

        /* Payment & Security */
        .footer-payment-security {
          display: flex;
          align-items: center;
          gap: 24px;
        }

        .payment-icons {
          display: flex;
          gap: 12px;
          align-items: center;
        }

        .payment-icon {
          height: 24px;
          width: auto;
          opacity: 0.6;
          filter: grayscale(100%);
          transition: all 300ms ease;
        }

        .payment-icon:hover {
          opacity: 0.9;
          filter: grayscale(0%);
        }

        .security-badges {
          display: flex;
          gap: 12px;
          align-items: center;
        }

        .security-badge {
          display: flex;
          align-items: center;
          gap: 6px;
          font-size: 13px;
          color: var(--emerald-pale);
          opacity: 0.6;
        }

        .security-badge i {
          font-size: 16px;
        }

        /* ============================================
           BACK TO TOP BUTTON
           ============================================ */

        .back-to-top-btn {
          position: fixed;
          bottom: 32px;
          right: 32px;
          width: 50px;
          height: 50px;
          border-radius: 50%;
          background: var(--champagne-gold);
          border: none;
          color: var(--primary-emerald);
          font-size: 20px;
          cursor: pointer;
          box-shadow: 0 4px 16px rgba(229, 203, 175, 0.4);
          opacity: 0;
          visibility: hidden;
          transform: translateY(20px);
          transition: all 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
          z-index: 999;
        }

        .back-to-top-btn.show {
          opacity: 1;
          visibility: visible;
          transform: translateY(0);
        }

        .back-to-top-btn:hover {
          background: var(--gold-rich);
          transform: translateY(-4px);
          box-shadow: 0 8px 24px rgba(229, 203, 175, 0.6);
        }

        .back-to-top-btn:active {
          transform: translateY(-2px);
        }

        .back-to-top-btn i {
          display: flex;
          align-items: center;
          justify-content: center;
        }

        /* Pulse animation */
        @keyframes backToTopPulse {
          0%, 100% {
            box-shadow: 0 4px 16px rgba(229, 203, 175, 0.4);
          }
          50% {
            box-shadow: 0 4px 16px rgba(229, 203, 175, 0.4), 0 0 0 8px rgba(229, 203, 175, 0.2);
          }
        }

        .back-to-top-btn.show {
          animation: backToTopPulse 2s ease infinite;
        }

        /* ============================================
           RESPONSIVE DESIGN - Footer
           ============================================ */

        /* Tablet (768-1023px) */
        @media (max-width: 1023px) {
          .footer-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 40px;
          }

          .footer-main-content {
            padding: 0 20px 40px;
          }
        }

        /* Mobile (767px and below) */
        @media (max-width: 767px) {
          .modern-footer {
            padding-top: 48px;
          }

          .footer-grid {
            grid-template-columns: 1fr;
            gap: 32px;
          }

          .footer-main-content {
            padding: 0 16px 32px;
          }

          .footer-description {
            max-width: 100%;
          }

          .footer-bottom-content {
            flex-direction: column;
            gap: 20px;
            text-align: center;
          }

          .footer-bottom-left {
            align-items: center;
          }

          .footer-bottom-links {
            justify-content: center;
          }

          .footer-switchers {
            justify-content: center;
          }

          .footer-payment-security {
            flex-direction: column;
            gap: 16px;
          }

          .payment-icons,
          .security-badges {
            justify-content: center;
          }

          /* Back to Top - Mobile */
          .back-to-top-btn {
            bottom: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            font-size: 18px;
          }
        }

        /* Extra Small (480px and below) */
        @media (max-width: 480px) {
          .footer-logo-text {
            font-size: 22px;
          }

          .footer-logo-icon {
            font-size: 24px;
          }

          .footer-column-title {
            font-size: 16px;
          }

          .footer-link,
          .footer-contact-item,
          .footer-description {
            font-size: 13px;
          }

          .footer-copyright {
            font-size: 12px;
          }

          .payment-icon {
            height: 20px;
          }

          .security-badge {
            font-size: 12px;
          }
        }

        /* ============================================
           GLOBAL ANIMATIONS & INTERACTIONS
           ============================================ */

        /* Hover Effects Library */
        .card-hover-effect {
          transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card-hover-effect:hover {
          transform: translateY(-8px);
          box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
        }

        .button-hover-effect {
          transition: all 300ms ease;
        }

        .button-hover-effect:hover {
          transform: translateY(-2px);
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
        }

        .icon-hover-effect {
          transition: all 300ms ease;
        }

        .icon-hover-effect:hover {
          transform: rotate(15deg) scale(1.15);
        }

        .link-hover-effect {
          position: relative;
          transition: color 300ms ease;
        }

        .link-hover-effect::after {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          width: 0;
          height: 2px;
          background: currentColor;
          transition: width 300ms ease;
        }

        .link-hover-effect:hover::after {
          width: 100%;
        }

        .image-hover-zoom {
          overflow: hidden;
        }

        .image-hover-zoom img {
          transition: transform 500ms ease;
        }

        .image-hover-zoom:hover img {
          transform: scale(1.1);
        }

        /* Loading States */
        .button-loading {
          position: relative;
          opacity: 0.7;
          cursor: not-allowed;
          pointer-events: none;
        }

        .button-loading::after {
          content: '';
          position: absolute;
          width: 16px;
          height: 16px;
          top: 50%;
          left: 50%;
          margin-left: -8px;
          margin-top: -8px;
          border: 2px solid rgba(255, 255, 255, 0.3);
          border-top-color: white;
          border-radius: 50%;
          animation: spinner 0.6s linear infinite;
        }

        @keyframes spinner {
          to {
            transform: rotate(360deg);
          }
        }

        /* Parallax Effects (Desktop Only) */
        @media (min-width: 1024px) {
          .parallax-slow {
            transition: transform 0.5s ease-out;
          }
        }

        /* Disable parallax on mobile */
        @media (max-width: 1023px) {
          .parallax-slow {
            transform: none !important;
          }
        }

        /* Common Utility Styles */
        .hero-gradient {
            background: rgba(7, 59, 58, 0.6);
        }

        .parallax-bg {
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            position: relative;
        }

            .parallax-bg::before {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(7, 59, 58, 0.4);
            }

        .section-padding {
            padding: 5rem 0;
        }

        @media(max-width:768px) {
            .section-padding {
                padding: 3rem 0;
            }
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--dartmouth-green), var(--pigment-green));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .footer-bg {
            position: relative;
            background-image: url("https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1920&q=80");
            background-size: cover;
            background-position: center;
        }

            .footer-bg::before {
                content: "";
                position: absolute;
                inset: 0;
                background-color: rgba(7, 59, 58, .7);
                z-index: 1;
            }

        .footer-content {
            position: relative;
            z-index: 2;
        }

        .why-us-card {
            transition: .3s;
            padding: 1.5rem;
            border-radius: .75rem;
            background: #fff;
            border: 1px solid #e5e7eb;
        }

            .why-us-card:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 20px rgba(0, 0, 0, .1);
            }

                .why-us-card:hover .icon-bg {
                    background: var(--ecru) !important;
                }

                    .why-us-card:hover .icon-bg i {
                        color: var(--midnight-green) !important;
                    }

        .hero-title {
            text-shadow: 0 2px 10px rgba(0, 0, 0, .5);
        }

        /* ============================================
           ACCESSIBILITY & FOCUS STATES
           ============================================ */

        /* Enhanced Focus Indicators */
        *:focus-visible {
            outline: 2px solid #c9a877; /* Gold-rich */
            outline-offset: 2px;
        }

        .nav-link:focus-visible,
        .user-account-btn:focus-visible,
        .cta-book-now:focus-visible,
        .search-input:focus-visible {
            outline: 2px solid #c9a877;
            outline-offset: 2px;
            box-shadow: 0 0 0 4px rgba(201, 168, 119, 0.2);
        }

        /* High Contrast Mode Support */
        @media (prefers-contrast: high) {
            .nav-link,
            .search-input,
            .user-account-btn {
                border-width: 2px;
            }
        }

        /* Reduced Motion Support */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }

            .modern-header,
            .nav-link,
            .search-input,
            .user-account-btn,
            .cta-book-now,
            .dropdown-menu {
                transition: none !important;
                animation: none !important;
            }

            /* Keep essential hover effects for usability */
            .nav-link:hover,
            .cta-book-now:hover {
                transition: color 0.1s ease, background-color 0.1s ease;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="font-sans" style="color: var(--text-dark)">

