<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<connectionStrings>
		<add name="constr"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=D:\Exploria\Tours&amp;Travels\App_Data\ToursTravels.mdf;Initial Catalog=ToursTravels;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<!-- Increased maxRequestLength to 51200 KB (50 MB) to allow larger file uploads -->
		<httpRuntime targetFramework="4.7.2" maxRequestLength="51200" />
	</system.web>

	<system.webServer>
		<defaultDocument>
			<files>
				<clear />
				<add value="Home.aspx" />
				<add value="Default.aspx" />
				<add value="index.html" />
			</files>
		</defaultDocument>
		<security>
			<requestFiltering>
				<!-- Increased maxAllowedContentLength to 52428800 bytes (50 MB) for IIS -->
				<requestLimits maxAllowedContentLength="52428800" />
			</requestFiltering>
		</security>
	</system.webServer>
</configuration>
