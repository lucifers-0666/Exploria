<?xml version="1.0" encoding="utf-8"?>
<CrystalReport xmlns="urn:crystal-reports:schemas:report-detail" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:crystal-reports:schemas:report-detail http://www.businessobjects.com/products/xml/CR2008Schema.xsd">
  <ReportHeader>
    <Section Height="2000">
      <!-- Company Logo and Header -->
      <TextField Top="50" Left="50" Width="2000" Height="200" Font="Arial" FontSize="24" FontWeight="Bold" TextColor="073b3a">
        Exploria Tours & Travels
      </TextField>
      <TextField Top="250" Left="50" Width="2000" Height="150" Font="Arial" FontSize="12" TextColor="666666">
        Your Adventure Begins Here | www.exploria.com | contact@exploria.com
      </TextField>
      <Line Top="450" Left="50" Width="7400" Height="2" BorderColor="073b3a"/>
      
      <!-- Invoice Title -->
      <TextField Top="500" Left="50" Width="2000" Height="200" Font="Arial" FontSize="20" FontWeight="Bold" TextColor="0b6e4f">
        BOOKING INVOICE
      </TextField>
      
      <!-- Invoice Date and Number -->
      <TextField Top="750" Left="50" Width="1500" Height="150" Font="Arial" FontSize="11" FontWeight="Bold">
        Invoice Date:
      </TextField>
      <TextField Top="750" Left="1600" Width="1500" Height="150" Font="Arial" FontSize="11" Formula="{BookingDate}"/>
      
      <TextField Top="900" Left="50" Width="1500" Height="150" Font="Arial" FontSize="11" FontWeight="Bold">
        Booking ID:
      </TextField>
      <TextField Top="900" Left="1600" Width="1500" Height="150" Font="Arial" FontSize="11" Formula="{BookingId}"/>
    </Section>
  </ReportHeader>
  
  <PageHeader>
    <Section Height="1200">
      <!-- Customer Details Box -->
      <Box Top="50" Left="50" Width="3500" Height="1000" BorderColor="cccccc" BackgroundColor="f9f9f9"/>
      <TextField Top="100" Left="100" Width="3000" Height="150" Font="Arial" FontSize="12" FontWeight="Bold" TextColor="073b3a">
        CUSTOMER DETAILS
      </TextField>
      <TextField Top="300" Left="100" Width="3000" Height="120" Font="Arial" FontSize="10" Formula="'Name: ' + {TravelerFirstName} + ' ' + {TravelerLastName}"/>
      <TextField Top="450" Left="100" Width="3000" Height="120" Font="Arial" FontSize="10" Formula="'Email: ' + {TravelerEmail}"/>
      <TextField Top="600" Left="100" Width="3000" Height="120" Font="Arial" FontSize="10" Formula="'Phone: ' + {TravelerPhone}"/>
      <TextField Top="750" Left="100" Width="3000" Height="120" Font="Arial" FontSize="10" Formula="'Travel Date: ' + {TravelDate}"/>
      
      <!-- Booking Details Box -->
      <Box Top="50" Left="3700" Width="3850" Height="1000" BorderColor="cccccc" BackgroundColor="f9f9f9"/>
      <TextField Top="100" Left="3750" Width="3700" Height="150" Font="Arial" FontSize="12" FontWeight="Bold" TextColor="073b3a">
        BOOKING DETAILS
      </TextField>
      <TextField Top="300" Left="3750" Width="3700" Height="120" Font="Arial" FontSize="10" Formula="'Destination: ' + {DestinationName}"/>
      <TextField Top="450" Left="3750" Width="3700" Height="120" Font="Arial" FontSize="10" Formula="'Duration: ' + {Duration}"/>
      <TextField Top="600" Left="3750" Width="3700" Height="120" Font="Arial" FontSize="10" Formula="'Adults: ' + ToText({NumberOfAdults}, 0) + ' | Children: ' + ToText({NumberOfChildren}, 0)"/>
      <TextField Top="750" Left="3750" Width="3700" Height="120" Font="Arial" FontSize="10" Formula="'Booking Status: ' + {BookingStatus}"/>
    </Section>
  </PageHeader>
  
  <Details>
    <Section Height="1500">
      <Line Top="0" Left="50" Width="7400" Height="2" BorderColor="cccccc"/>
      
      <!-- Pricing Table Header -->
      <Box Top="50" Left="50" Width="7400" Height="200" BackgroundColor="073b3a"/>
      <TextField Top="80" Left="100" Width="3000" Height="140" Font="Arial" FontSize="11" FontWeight="Bold" TextColor="ffffff">
        DESCRIPTION
      </TextField>
      <TextField Top="80" Left="3200" Width="1200" Height="140" Font="Arial" FontSize="11" FontWeight="Bold" TextColor="ffffff" TextAlign="Center">
        QUANTITY
      </TextField>
      <TextField Top="80" Left="4500" Width="1400" Height="140" Font="Arial" FontSize="11" FontWeight="Bold" TextColor="ffffff" TextAlign="Right">
        RATE
      </TextField>
      <TextField Top="80" Left="6000" Width="1400" Height="140" Font="Arial" FontSize="11" FontWeight="Bold" TextColor="ffffff" TextAlign="Right">
        AMOUNT
      </TextField>
      
      <!-- Adults Row -->
      <TextField Top="300" Left="100" Width="3000" Height="150" Font="Arial" FontSize="10" Formula="'Adult Tickets (' + {DestinationName} + ')'"/>
      <TextField Top="300" Left="3200" Width="1200" Height="150" Font="Arial" FontSize="10" TextAlign="Center" Formula="ToText({NumberOfAdults}, 0)"/>
      <TextField Top="300" Left="4500" Width="1400" Height="150" Font="Arial" FontSize="10" TextAlign="Right" Formula="'₹' + ToText({PricePerPerson}, 2, '')"/>
      <TextField Top="300" Left="6000" Width="1400" Height="150" Font="Arial" FontSize="10" TextAlign="Right" Formula="'₹' + ToText({NumberOfAdults} * {PricePerPerson}, 2, '')"/>
      
      <!-- Children Row -->
      <TextField Top="500" Left="100" Width="3000" Height="150" Font="Arial" FontSize="10" Formula="'Children Tickets (' + {DestinationName} + ')'"/>
      <TextField Top="500" Left="3200" Width="1200" Height="150" Font="Arial" FontSize="10" TextAlign="Center" Formula="ToText({NumberOfChildren}, 0)"/>
      <TextField Top="500" Left="4500" Width="1400" Height="150" Font="Arial" FontSize="10" TextAlign="Right" Formula="'₹' + ToText({PricePerPerson} / 2, 2, '')"/>
      <TextField Top="500" Left="6000" Width="1400" Height="150" Font="Arial" FontSize="10" TextAlign="Right" Formula="'₹' + ToText({NumberOfChildren} * ({PricePerPerson} / 2), 2, '')"/>
      
      <Line Top="700" Left="50" Width="7400" Height="2" BorderColor="cccccc"/>
      
      <!-- Subtotal -->
      <TextField Top="750" Left="4500" Width="1400" Height="150" Font="Arial" FontSize="11" FontWeight="Bold" TextAlign="Right">
        Subtotal:
      </TextField>
      <TextField Top="750" Left="6000" Width="1400" Height="150" Font="Arial" FontSize="11" TextAlign="Right" Formula="'₹' + ToText({TotalAmount}, 2, '')"/>
      
      <!-- Tax (GST 18%) -->
      <TextField Top="950" Left="4500" Width="1400" Height="150" Font="Arial" FontSize="10" TextAlign="Right">
        Tax (GST 18%):
      </TextField>
      <TextField Top="950" Left="6000" Width="1400" Height="150" Font="Arial" FontSize="10" TextAlign="Right" Formula="'₹' + ToText({TotalAmount} * 0.18, 2, '')"/>
      
      <Line Top="1150" Left="4400" Width="3050" Height="3" BorderColor="073b3a"/>
      
      <!-- Total -->
      <Box Top="1200" Left="4400" Width="3050" Height="250" BackgroundColor="e8f4ed"/>
      <TextField Top="1230" Left="4500" Width="1400" Height="180" Font="Arial" FontSize="14" FontWeight="Bold" TextAlign="Right" TextColor="073b3a">
        TOTAL AMOUNT:
      </TextField>
      <TextField Top="1230" Left="6000" Width="1400" Height="180" Font="Arial" FontSize="14" FontWeight="Bold" TextAlign="Right" TextColor="073b3a" Formula="'₹' + ToText({TotalAmount} * 1.18, 2, '')"/>
    </Section>
  </Details>
  
  <ReportFooter>
    <Section Height="1500">
      <Line Top="50" Left="50" Width="7400" Height="2" BorderColor="cccccc"/>
      
      <!-- Payment Information -->
      <TextField Top="150" Left="50" Width="7400" Height="150" Font="Arial" FontSize="12" FontWeight="Bold" TextColor="0b6e4f">
        PAYMENT INFORMATION
      </TextField>
      <TextField Top="350" Left="50" Width="3500" Height="120" Font="Arial" FontSize="10" Formula="'Payment Status: ' + {PaymentStatus}"/>
      <TextField Top="500" Left="50" Width="3500" Height="120" Font="Arial" FontSize="10" Formula="'Payment Method: ' + {PaymentMethod}"/>
      
      <!-- Terms and Conditions -->
      <TextField Top="700" Left="50" Width="7400" Height="150" Font="Arial" FontSize="11" FontWeight="Bold" TextColor="073b3a">
        TERMS & CONDITIONS
      </TextField>
      <TextField Top="900" Left="50" Width="7400" Height="100" Font="Arial" FontSize="9" TextColor="666666">
        1. Cancellation must be made 7 days before the travel date for a full refund.
      </TextField>
      <TextField Top="1020" Left="50" Width="7400" Height="100" Font="Arial" FontSize="9" TextColor="666666">
        2. Please carry a valid ID proof during your travel.
      </TextField>
      <TextField Top="1140" Left="50" Width="7400" Height="100" Font="Arial" FontSize="9" TextColor="666666">
        3. For any queries, contact us at support@exploria.com or call +91-1800-123-456
      </TextField>
      
      <!-- Thank You Message -->
      <TextField Top="1300" Left="50" Width="7400" Height="150" Font="Arial" FontSize="12" FontWeight="Bold" TextAlign="Center" TextColor="0b6e4f">
        Thank you for choosing Exploria! Have a wonderful journey!
      </TextField>
    </Section>
  </ReportFooter>
  
  <PageFooter>
    <Section Height="300">
      <Line Top="0" Left="50" Width="7400" Height="2" BorderColor="073b3a"/>
      <TextField Top="50" Left="50" Width="3500" Height="120" Font="Arial" FontSize="9" TextColor="999999">
        Exploria Tours & Travels | www.exploria.com
      </TextField>
      <TextField Top="50" Left="4000" Width="3450" Height="120" Font="Arial" FontSize="9" TextAlign="Right" TextColor="999999" Formula="'Page ' + ToText(PageNumber, 0) + ' of ' + ToText(TotalPageCount, 0)"/>
      <TextField Top="170" Left="50" Width="7400" Height="100" Font="Arial" FontSize="8" TextAlign="Center" TextColor="999999">
        This is a computer-generated invoice and does not require a signature.
      </TextField>
    </Section>
  </PageFooter>
</CrystalReport>
